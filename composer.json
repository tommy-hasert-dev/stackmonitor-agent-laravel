{
    "name": "stackmonitor/agent-laravel",
    "description": "Read-only StackMonitor agent for Laravel applications",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "monitoring", "stackmonitor"],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^2.11|^3.13",
        "laravel/pint": "^1.32.1",
        "opis/json-schema": "^2.6",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.36|^3.8|^4.1|^5.2.1",
        "shipmonk/composer-dependency-analyser": "^1.8"
    },
    "autoload": {
        "psr-4": { "StackMonitor\\Agent\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "StackMonitor\\Agent\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": { "providers": ["StackMonitor\\Agent\\AgentServiceProvider"] }
    },
    "scripts": {
        "lint": "pint",
        "types:check": "phpstan analyse --no-progress --memory-limit=1G",
        "deps": "composer-dependency-analyser",
        "test": ["pint --test", "@types:check", "@deps", "pest"]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": { "pestphp/pest-plugin": true }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
